# docker-compose 와 백엔드가 함께 읽는 값. 실제 파일은 .env 로 복사해서 쓴다.
DB_PASSWORD=rootpassword

# HS256 서명 키. 32바이트(한글 아닌 문자 기준 32자) 이상이어야 한다.
JWT_ACCESS_SECRET=change-me-to-a-long-random-access-secret-value
JWT_REFRESH_SECRET=change-me-to-a-long-random-refresh-secret-value

# 회원가입 이메일 인증.
# false 로 두면 메일을 보내지 않고 인증번호를 서버 로그에 찍는다(개발용).
# true 로 켤 때만 아래 계정 정보가 필요하다. Gmail 은 계정 비밀번호가 아니라 앱 비밀번호를 넣는다.
MAIL_ENABLED=false
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
